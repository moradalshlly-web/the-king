<!DOCTYPE html>
<html lang="ar" dir="rtl" data-theme="purple">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover">
    <meta name="theme-color" content="#7c3aed">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <title>MOROAI — استوديو الذكاء المستقل</title>
    <link rel="stylesheet" href="./design.css">
    <link rel="stylesheet" href="./moroai-app.css">
</head>
<body data-state="idle">

<!-- ═══════════════════════════════════════════════
     TOP BAR
     ═══════════════════════════════════════════════ -->
<header class="topbar" role="banner">
    <button class="icon-btn" id="menu-btn" aria-label="القائمة">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <line x1="4" y1="7" x2="20" y2="7"/>
            <line x1="4" y1="12" x2="20" y2="12"/>
            <line x1="4" y1="17" x2="20" y2="17"/>
        </svg>
    </button>

    <div class="brand">
        <div class="brand-orb" aria-hidden="true"></div>
        <span class="brand-name">MOROAI</span>
    </div>

    <button class="search-trigger" id="search-btn" aria-label="بحث شامل">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/>
            <line x1="16.5" y1="16.5" x2="21" y2="21"/>
        </svg>
        <span class="search-label">ابحث في MOROAI أو اسأل أي شيء...</span>
    </button>

    <button class="icon-btn" id="theme-btn" aria-label="الثيم">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="12" cy="12" r="9"/>
            <path d="M12 3v18M3 12h18"/>
        </svg>
    </button>

    <div class="avatar" id="profile-btn" role="button" aria-label="الملف">
        <span>M</span>
    </div>
</header>

<!-- ═══════════════════════════════════════════════
     MAIN: CHAT + PREVIEW
     ═══════════════════════════════════════════════ -->
<main class="main-split" role="main">

    <!-- CHAT PANE -->
    <section class="chat-pane" id="chat-pane">
        <div class="chat-feed" id="chat-feed" aria-live="polite">

            <!-- Welcome card -->
            <div class="welcome" id="welcome-card">
                <div class="welcome-orb"></div>
                <h2 class="welcome-title">أهلاً بك في MOROAI</h2>
                <p class="welcome-sub">
                    صديقك الذكي — يبني، يتعلّم، يتطوّر.
                    اكتب ما تريد، وأنا أتولى الباقي.
                </p>
                <div class="quick-actions">
                    <button class="chip" data-prompt="أنشئ صفحة هبوط لشركة تقنية">🎨 صفحة هبوط</button>
                    <button class="chip" data-prompt="اشرح لي كيف يعمل Python">📚 اشرح لي</button>
                    <button class="chip" data-prompt="استورد مشروع مفتوح المصدر">📦 استيراد مشروع</button>
                    <button class="chip" data-prompt="غيّر لون الموقع إلى الذهبي">⚙️ عدّل الموقع</button>
                </div>
            </div>

        </div>

        <!-- COMPOSER -->
        <div class="composer-wrapper">
            <div class="voice-bar" id="voice-bar" hidden>
                <span class="voice-dot"></span>
                <span id="voice-status">جاري التسجيل...</span>
                <span id="voice-timer" class="font-mono">0:00</span>
                <button class="btn btn-ghost" id="voice-stop">إيقاف</button>
            </div>

            <div class="attachments" id="attachments" hidden></div>

            <div class="composer">
                <button class="icon-btn" id="attach-btn" aria-label="إرفاق">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <line x1="12" y1="5" x2="12" y2="19"/>
                        <line x1="5" y1="12" x2="19" y2="12"/>
                    </svg>
                </button>

                <textarea id="composer-input" rows="1"
                    placeholder="اكتب رسالتك، اطلب، عدّل، أو ابحث..."
                    aria-label="مربع الرسالة"></textarea>

                <button class="icon-btn" id="mic-btn" aria-label="صوت">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <rect x="9" y="3" width="6" height="11" rx="3"/>
                        <path d="M5 11a7 7 0 0 0 14 0M12 18v3"/>
                    </svg>
                </button>

                <button class="send-btn" id="send-btn" aria-label="إرسال">
                    <svg width="18" height="18" viewBox="0 0 24 24"
                         fill="currentColor" style="transform: scaleX(-1);">
                        <path d="M3 11l18-8-8 18-2-8-8-2z"/>
                    </svg>
                </button>
            </div>

            <div class="composer-hint" id="composer-hint">
                <span id="mode-indicator">🎯 مفصّل</span>
                <span class="dot">·</span>
                <span>MOROAI قد يخطئ — راجع المهم</span>
            </div>
        </div>
    </section>

    <!-- PREVIEW PANE (desktop) -->
    <aside class="preview-pane" id="preview-pane">
        <div class="preview-header">
            <span class="preview-title" id="preview-title">الورشة</span>
            <button class="icon-btn small" id="preview-close" hidden>✕</button>
        </div>
        <div class="preview-content" id="preview-content">
            <div class="preview-empty">
                <div class="preview-empty-icon">✨</div>
                <p>المعاينة ستظهر هنا حسب المهمة</p>
                <p class="text-muted" style="font-size:.85rem;">
                    صور، صوت، 3D، كود، تقارير...
                </p>
            </div>
        </div>
    </aside>

</main>

<!-- ═══════════════════════════════════════════════
     RIGHT DRAWER
     ═══════════════════════════════════════════════ -->
<aside class="drawer" id="drawer" aria-label="القائمة الجانبية">
    <div class="drawer-header">
        <span class="drawer-title">MOROAI Suite</span>
        <button class="icon-btn small" id="drawer-close">✕</button>
    </div>

    <nav class="drawer-nav">
        <div class="nav-section">الإنتاج</div>
        <a href="#" data-action="studio">🎬 Studio</a>
        <a href="#" data-action="learn">📚 Learn</a>
        <a href="#" data-action="gamer">🎮 Gamer</a>
        <a href="#" data-action="build">🏗️ Build</a>

        <div class="nav-section">الورشة</div>
        <a href="#" data-action="tools">🔧 الأدوات</a>
        <a href="#" data-action="agents">🤖 الوكلاء</a>
        <a href="#" data-action="projects">📦 المشاريع</a>
        <a href="#" data-action="sources">🌐 المصادر والمزودون</a>
        <a href="#" data-action="models">🧠 النماذج المستوردة</a>
        <a href="#" data-action="skills">🎓 المهارات</a>

        <div class="nav-section">شخصي</div>
        <a href="#" data-action="sessions">💬 الجلسات</a>
        <a href="#" data-action="insights">🧠 تحليل ذاتي</a>
        <a href="#" data-action="settings">⚙️ الإعدادات</a>
    </nav>

    <div class="drawer-footer">
        <div class="status-line" id="drawer-status">جاري التحميل...</div>
    </div>
</aside>

<!-- ═══════════════════════════════════════════════
     MOBILE BOTTOM SHEET (preview)
     ═══════════════════════════════════════════════ -->
<div class="bottom-sheet" id="bottom-sheet" aria-hidden="true">
    <div class="sheet-handle"></div>
    <div class="sheet-header">
        <span class="sheet-title" id="sheet-title">المعاينة</span>
        <button class="icon-btn small" id="sheet-close">✕</button>
    </div>
    <div class="sheet-body" id="sheet-body"></div>
</div>

<!-- ═══════════════════════════════════════════════
     MODALS
     ═══════════════════════════════════════════════ -->

<!-- Theme picker -->
<div class="modal" id="theme-modal" hidden>
    <div class="modal-backdrop" data-close></div>
    <div class="modal-panel modal-sm">
        <div class="modal-head">
            <h3>اختر الهوية البصرية</h3>
            <button class="icon-btn small" data-close>✕</button>
        </div>
        <div class="theme-grid">
            <button class="theme-option" data-theme="purple">
                <span class="theme-swatch purple"></span>
                <span>بنفسجي ملكي</span>
            </button>
            <button class="theme-option" data-theme="gold">
                <span class="theme-swatch gold"></span>
                <span>ذهبي إمبراطوري</span>
            </button>
            <button class="theme-option" data-theme="emerald">
                <span class="theme-swatch emerald"></span>
                <span>زمردي سيبراني</span>
            </button>
            <button class="theme-option" data-theme="ruby">
                <span class="theme-swatch ruby"></span>
                <span>ياقوتي ليلي</span>
            </button>
        </div>
    </div>
</div>

<!-- Import panel -->
<div class="modal" id="import-modal" hidden>
    <div class="modal-backdrop" data-close></div>
    <div class="modal-panel">
        <div class="modal-head">
            <h3>استيراد</h3>
            <button class="icon-btn small" data-close>✕</button>
        </div>
        <div class="tabs">
            <button class="tab active" data-tab="model">🧠 نموذج</button>
            <button class="tab" data-tab="project">📦 مشروع</button>
            <button class="tab" data-tab="provider">🌐 مزود</button>
        </div>
        <div class="tab-panels">
            <div class="tab-panel active" data-panel="model">
                <p class="text-muted">ابحث في Hugging Face أو الصق معرّف النموذج</p>
                <input type="text" class="input" id="import-model-input"
                       placeholder="مثال: oddadmix/Nabra-7M-Distill">
                <button class="btn btn-primary mt-4" id="import-model-btn">
                    🔍 بحث / استيراد
                </button>
                <div class="import-results" id="import-model-results"></div>
            </div>
            <div class="tab-panel" data-panel="project">
                <p class="text-muted">الصق رابط GitHub للمشروع المفتوح المصدر</p>
                <input type="text" class="input" id="import-project-input"
                       placeholder="https://github.com/owner/repo">
                <button class="btn btn-primary mt-4" id="import-project-btn">
                    📥 تحليل واستيراد
                </button>
            </div>
            <div class="tab-panel" data-panel="provider">
                <p class="text-muted">أضف مزوداً جديداً (اسم + رابط + مفتاح)</p>
                <input type="text" class="input" id="import-provider-name"
                       placeholder="اسم المزود (مثال: cerebras)">
                <input type="text" class="input mt-4" id="import-provider-url"
                       placeholder="Base URL">
                <input type="password" class="input mt-4" id="import-provider-key"
                       placeholder="API Key">
                <button class="btn btn-primary mt-4" id="import-provider-btn">
                    ✅ إضافة المزود
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Omni Search -->
<div class="modal" id="search-modal" hidden>
    <div class="modal-backdrop" data-close></div>
    <div class="modal-panel modal-top">
        <input type="text" class="input input-lg" id="omni-input"
               placeholder="ابحث في MOROAI، الملفات، الوكلاء، الويب...">
        <div class="search-results" id="omni-results"></div>
    </div>
</div>

<script src="./moroai-app.js"></script>
</body>
</html>
